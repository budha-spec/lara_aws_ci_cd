option_settings:

  aws:elasticbeanstalk:application:environment:

    APP_ENV: production
    APP_DEBUG: "false"
    LOG_CHANNEL: stack
    APP_TIMEZONE: UTC

  aws:elasticbeanstalk:container:php:phpini:

    document_root: /public

  aws:elasticbeanstalk:hostmanager:

    LogPublicationControl: true